PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/cosmobit-labs
FIREBASE_PROJECT_ID=
# Path to a securely mounted Firebase service-account JSON, or use supported ADC.
# Never commit the credential file.
GOOGLE_APPLICATION_CREDENTIALS=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Actual trusted proxy CIDRs only; omit when running directly.
# TRUST_PROXY=loopback
# Local tests only, with a demo- project. Never enable in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
