PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/cosmobit-labs
FIREBASE_PROJECT_ID=
# Path to a securely mounted Firebase service-account JSON, or use supported ADC.
# Never commit the credential file.
GOOGLE_APPLICATION_CREDENTIALS=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Actual trusted proxy CIDRs only; omit when running directly.
# TRUST_PROXY=loopback
# Local tests only, with a demo- project. Never enable in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Images: use Cloudinary in production; keep keys on the backend only.
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Explicitly disabled as requested. Queued email waits for later configuration.
NOTIFICATION_EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
